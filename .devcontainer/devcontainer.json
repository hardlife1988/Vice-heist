{
  "name": "Vice Heist",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "forwardPorts": [5000],
  "portsAttributes": {
    "5000": {
      "label": "Vice Heist game",
      "onAutoForward": "openPreview",
      "visibility": "public",
      "requireLocalPort": true
    }
  },
  "remoteEnv": {
    "SESSION_SECRET": "codespace-dev-secret-change-me",
    "PORT": "5000"
  },
  "postCreateCommand": "pip install -r requirements.txt && pip install zstandard || true",
  "postStartCommand": "python -m http.server 5000 --bind 0.0.0.0 --directory dist",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
